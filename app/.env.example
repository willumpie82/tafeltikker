PORT=3000
HOST=0.0.0.0
DB_PATH=data/tafeltikker.sqlite

# Session signing keys, 32 random bytes as hex. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in production; if left unset, a throwaway key is generated per
# process start (fine for local dev, but sessions won't survive a restart).
CHILD_SESSION_KEY=
PARENT_SESSION_KEY=

# Used only by `npm run db:seed` to create the first parent (as system_admin,
# the instance owner) + demo children.
SEED_PARENT_USERNAME=ouder
SEED_PARENT_PASSWORD=wachtwoord123

# Base URL used to build shareable invite links (e.g. https://tafeltikker.oldemans.nl).
# If unset, falls back to whatever host/port the admin's request came in on —
# fine for LAN-only use, but should be set once this instance sits behind a
# real domain, so invite links don't end up pointing at an internal address.
PUBLIC_BASE_URL=
