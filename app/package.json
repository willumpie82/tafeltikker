{
  "name": "tafeltikker-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server.ts",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build:client": "esbuild src/client/main.ts --bundle --outfile=public/app.js && esbuild src/client/parent/main.ts --bundle --outfile=public/parent.js && esbuild src/client/admin/main.ts --bundle --outfile=public/admin.js && esbuild src/client/register/main.ts --bundle --outfile=public/register.js"
  },
  "dependencies": {
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
